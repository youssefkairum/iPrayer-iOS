    "Continue your journey. Take a moment to read Surah %@ today." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واصل رحلتك. خذ لحظة لقراءة سورة %@ اليوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze deine Reise fort. Nimm dir einen Moment Zeit, um heute Sure %@ zu lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez votre voyage. Prenez un moment pour lire la sourate %@ aujourd'hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी यात्रा जारी रखें। आज सूरह %@ पढ़ने के लिए कुछ समय निकालें।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжайте свой путь. Найдите минутку, чтобы прочитать суру %@ сегодня."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolculuğunuza devam edin. Bugün %@ Suresini okumak için bir an ayırın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا سفر جاری رکھیں۔ آج سورہ %@ پڑھنے کے لیے کچھ وقت نکالیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续你的旅程。今天花点时间阅读古兰经第 %@ 章。"
          }
        }
      }
    },
