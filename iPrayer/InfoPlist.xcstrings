    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Shown by iOS in the location permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم iPrayer موقعك لحساب مواقيت الصلاة واتجاه القبلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer verwendet deinen Standort, um Gebetszeiten und die Qibla-Richtung zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer uses your location to calculate prayer times and the Qibla direction."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer utilise votre position pour calculer les horaires de prière et la direction de la Qibla."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer नमाज़ के वक्त और क़िबला की दिशा जानने के लिए आपके स्थान का उपयोग करता है।"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer использует вашу геопозицию для расчёта времени молитв и направления киблы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer, namaz vakitlerini ve kıble yönünü hesaplamak için konumunuzu kullanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer نماز کے اوقات اور قبلہ کی سمت معلوم کرنے کے لیے آپ کا مقام استعمال کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPrayer 使用您的位置来计算祈祷时间和朝向。"
          }
        }
      }
