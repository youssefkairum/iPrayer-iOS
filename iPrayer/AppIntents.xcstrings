    "The next prayer is %@ at %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصلاة القادمة هي %1$@، الساعة %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das nächste Gebet ist %1$@ um %2$@."
