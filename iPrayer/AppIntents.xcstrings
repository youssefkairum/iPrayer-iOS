    "Location access is needed to show prayer times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الوصول إلى الموقع لعرض مواقيت الصلاة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standortzugriff wird benötigt, um Gebetszeiten anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la localisation est nécessaire pour afficher les horaires de prière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के वक्त दिखाने के लिए स्थान की अनुमति आवश्यक है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для показа времени молитв нужен доступ к геопозиции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitlerini göstermek için konum erişimi gerekli."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات دکھانے کے لیے مقام تک رسائی درکار ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要位置权限才能显示祈祷时间。"
          }
        }
      }
    },
